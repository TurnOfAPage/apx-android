<?xml version="1.0" encoding="utf-8"?>
<!--
  全能外设 · 主控制面（横屏沉浸操控面，v1.19）。
  横屏就是"手机横过来当外设"，所以去掉一切取景框：
    · 顶栏（headerBar）整条隐藏 —— include 仍在，id 保留给代码
    · MIUIX 悬浮底栏（tabBar）整条隐藏 —— 改用四指左右滑切页
  · 通知栏 / 手势条由 MainActivity.applyImmersive() 一并盖掉
    ① 触控板页：左右分栏 —— 左 2/3（顶行操作 + 手势面），右 1/3（快捷键），不放方向键
    ② 键盘页  ：全键盘铺满整屏
    ③ 状态页 / ④ 设置页：复用竖屏块（无底栏，内容可滚到底）
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/contentStack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 占位：横屏隐藏，但 id 必须存在（代码统一 findViewById） -->
        <include
            layout="@layout/header_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <ViewFlipper
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ① 触控板页：横屏左右分栏（左 2/3=操作行+手势面，右 1/3=快捷键），不放方向键 -->
            <LinearLayout
                android:id="@+id/pageTouchpad"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <!-- 左栏（weight=2）：上=文件/剪贴板/屏幕/手柄/遥控 一行，下=手势面撑满 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:orientation="vertical">

                    <!-- v1.8 顶部操作 + 屏幕/手柄/遥控（TouchpadFragment.ensureViews 绑定） -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:id="@+id/btnFileSend"
                            style="@style/APTextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_touchpad_text_file"
                            android:contentDescription="@string/ui_main_label_file_send" />

                        <TextView
                            android:id="@+id/btnClipSend"
                            style="@style/APTextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/ui_touchpad_text_clipboard"
                            android:contentDescription="@string/ui_touchpad_text_clipboard" />

                        <TextView
                            android:id="@+id/btnScreen"
                            style="@style/APTextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/notify_action_screen"
                            android:contentDescription="@string/lay_main_cd_screen_open" />

                        <TextView
                            android:id="@+id/btnGamepad"
                            style="@style/APTextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/lay_main_text_gamepad"
                            android:contentDescription="@string/lay_main_cd_gamepad_open" />

                        <TextView
                            android:id="@+id/btnRemote"
                            style="@style/APTextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/ui_remote_text_remote"
                            android:contentDescription="@string/lay_main_cd_remote_open" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/touchArea"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card">

                        <TextView
                            android:id="@+id/tvTouchHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:clickable="false"
                            android:text="@string/ui_touchpad_text_cursor_swipe"
                            android:textAppearance="@style/APTextCaption" />
                    </FrameLayout>
                </LinearLayout>

                <!-- 栏间分隔线 -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="?android:attr/listDivider" />

                <!-- 右栏（weight=1）：快捷键（标题 + 编辑 + 网格，通栏可滚） -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/chipSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ui_touchpad_text_hotkey"
                            android:textAppearance="@style/APTextSubtitle" />

                        <TextView
                            android:id="@+id/btnEditChips"
                            style="@style/APTextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_common_edit"
                            android:contentDescription="@string/lay_main_cd_hotkey" />
                    </LinearLayout>

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/chipRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>
                </LinearLayout>
            </LinearLayout>

            <!-- ② 键盘页：全键盘铺满 -->
            <LinearLayout
                android:id="@+id/pageKeyboard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="2dp">

                <LinearLayout
                    android:id="@+id/keyboardBox"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ④ 设置页（状态页已并入设置顶，反馈#10） -->
            <include
                layout="@layout/page_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </ViewFlipper>

        <!-- 占位：横屏隐藏（id 必须存在，用于玻璃底栏与页签逻辑） -->
        <include
            layout="@layout/nav_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 批P：横屏操作条 pill（issue 实测）——触控板/键盘切换 + 方向锁 + 设置，替代四指滑唯一路径 -->
    <LinearLayout
        android:id="@+id/pillLandActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnLandTouchpad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="触控板"
            android:textColor="@color/md_on_surface"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnLandKeyboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="键盘"
            android:textColor="@color/md_on_surface"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnLandLock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="锁定"
            android:textColor="@color/md_on_surface"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnLandSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="设置"
            android:textColor="@color/md_on_surface"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 横屏沉浸右上角悬浮设置入口（反馈#2）：横屏 chrome 全隐时的常驻入口 -->
    <TextView
        android:id="@+id/btnSettingsFloat"
        style="@style/APTextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_card"
        android:elevation="4dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/ui_main_btn_settings_entry"
        android:visibility="gone" />
</FrameLayout>