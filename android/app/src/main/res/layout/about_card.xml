<?xml version="1.0" encoding="utf-8"?>
<!--
  关于卡的内部结构，由 com.allperiph.ui.AboutCard inflate（merge：直接并进卡片本体）。
  版本行的过程文案（检查中 / 已是最新 / 发现新版 / 失败）由 AboutCard 写入 tvVersion。
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/common_unknown"
        android:textAppearance="@style/APTextCaption" />

    <Button
        android:id="@+id/btnCheckUpdate"
        style="@style/APButtonGhost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/about_check_update" />

    <Button
        android:id="@+id/btnFeedback"
        style="@style/APButtonGhost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/about_feedback" />
</merge>
