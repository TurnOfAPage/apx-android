<?xml version="1.0" encoding="utf-8"?>
<!-- LocalSend 发送页（MVP2）：说明行 + 设备列表 + 空态提示 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/space_12">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/space_8"
        android:text="@string/lay_localsend_hint"
        android:textColor="@color/md_on_surface_variant"
        android:textSize="12sp" />

    <ListView
        android:id="@+id/lsDeviceList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/md_outline"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/lsEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="@dimen/space_24"
        android:text="@string/lay_localsend_empty"
        android:textColor="@color/md_on_surface_variant"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
