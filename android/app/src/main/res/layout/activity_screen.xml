<?xml version="1.0" encoding="utf-8"?>
<!--
  副屏全屏页：TextureView 铺满，左上角浮一行状态字。
  用 TextureView 而非 SurfaceView：沉浸式/过渡时 SurfaceView 容易出黑块与层级问题。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <TextureView
        android:id="@+id/surfaceScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/tvScreenHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="@dimen/space_12"
        android:paddingStart="@dimen/space_8"
        android:paddingTop="@dimen/space_6"
        android:paddingEnd="@dimen/space_8"
        android:paddingBottom="@dimen/space_6"
        android:background="@color/screen_scrim"
        android:text="@string/notify_action_screen"
        android:textColor="@color/screen_hint_text"
        android:textSize="12sp" />
</FrameLayout>
