<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页（复用块）：快捷键模板（**可折叠**）· 功能开关（含自动排序）· 环境摘要 · 主题方案 · 关于（版本/更新/反馈）· 维护。
  竖屏底部留 96dp 给悬浮底栏；横屏（layout-land）由外层覆盖为 16dp。

  折叠的原因：模板列表有 10 套预置 + 1 行自建入口，展开 ≈ 800dp，正好把一屏占满，
  导致"功能开关 / 主题方案"永远在第二屏。现在默认只留「当前模板 + 更换/展开」一行。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="@dimen/space_16"
    android:paddingEnd="@dimen/space_16"
    android:paddingBottom="@dimen/inset_bottom_nav">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_4">

        <!--
          两栏容器（实机反馈「分左右，常用占 1/3，用按钮加段文字」）：
            竖屏 —— 纵向堆叠：状态块在上、功能分组在下（与改造前视觉一致）
            横屏 —— 横向两栏：左 1/3 = 状态概览 + 传输按钮 + 分类/返回，
                             右 2/3 = 当前分类的功能分组
          排布由 MainActivity.applySettingsTwoPane() 在朝向变化时切换：只改这里的
          orientation 与两个 pane 的 LayoutParams，视图实例不变。
        -->
        <LinearLayout
            android:id="@+id/settingsTwoPane"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/paneStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 状态块（原状态页并入设置页顶，反馈#10）：状态概览 + 传输按钮。
                     根节点是 LinearLayout 平铺，滚动交给本页外层 ScrollView。 -->
                <include
                    layout="@layout/page_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/paneGroups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

        <!-- 分类列表首页（反馈#10 批 B，方案 B）：点行进二级页；二级页经返回行回首屏 -->
        <LinearLayout
            android:id="@+id/categoryHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_4">

            <TextView
                android:id="@+id/catGeneral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:paddingTop="@dimen/space_12"
                android:paddingBottom="@dimen/space_12"
                android:text="@string/ui_main_cat_general"
                android:textColor="@color/md_on_surface"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/catLook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:paddingTop="@dimen/space_12"
                android:paddingBottom="@dimen/space_12"
                android:text="@string/ui_main_cat_look"
                android:textColor="@color/md_on_surface"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/catRemote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:paddingTop="@dimen/space_12"
                android:paddingBottom="@dimen/space_12"
                android:text="@string/ui_main_cat_remote"
                android:textColor="@color/md_on_surface"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/catAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:paddingTop="@dimen/space_12"
                android:paddingBottom="@dimen/space_12"
                android:text="@string/ui_main_cat_about"
                android:textColor="@color/md_on_surface"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/catHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:paddingTop="@dimen/space_12"
                android:paddingBottom="@dimen/space_12"
                android:text="@string/ui_main_cat_help"
                android:textColor="@color/md_on_surface"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 二级页返回行（默认隐藏，进分类后显示，点击回首屏） -->
        <LinearLayout
            android:id="@+id/btnBackHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_6"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_16"
            android:paddingTop="@dimen/space_12"
            android:paddingBottom="@dimen/space_12"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_main_cat_back"
                android:textColor="@color/md_on_surface"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupGeneral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 链路诊断（原状态块「连接状态」卡内容）：root / USB 速度 / UDC / 服务 /
                 电池白名单五行，行的构建在 StatusFragment.buildLinkRows。 -->
            <LinearLayout
                style="@style/APCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_link"
                    android:textAppearance="@style/APTextSubtitle" />

                <LinearLayout
                    android:id="@+id/rowsLinkHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_6" />
            </LinearLayout>

        <!-- 批E：触摸板光标锁定（issue#44 · pad 光标跟随误触）；默认开 + 自动保存 -->
        <LinearLayout
            android:id="@+id/rowCursorLock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/space_12"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="@dimen/space_6">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="触摸板光标锁定
连上电脑后本窗隐藏系统光标，触控板点击只转发到电脑（Pad 防误触）"
                android:textColor="@color/md_on_surface"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switchCursorLock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- 快捷键模板：默认折叠，只显示当前这一套 -->
        <TextView
            style="@style/APSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lay_settings_text_hotkey_template" />

        <LinearLayout
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lay_settings_text_hotkey_template_touchpad"
                android:visibility="gone"
                android:textAppearance="@style/APTextCaption" />

            <LinearLayout
                android:id="@+id/rowTemplateCurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_8">

                <TextView
                    android:id="@+id/tvTemplateCurrent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="—"
                    android:textAppearance="@style/APTextSubtitle" />

                <TextView
                    android:id="@+id/btnToggleTemplates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/space_12"
                    android:paddingTop="@dimen/space_6"
                    android:paddingEnd="@dimen/space_2"
                    android:paddingBottom="@dimen/space_6"
                    android:text="@string/ui_main_template_expand"
                    android:textColor="@color/md_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/templatesBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_8"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 功能开关：模块启停 + 快捷键排序（同一张卡，风格统一也省一屏） -->
        <TextView
            style="@style/APSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lay_settings_modules" />

        <LinearLayout
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 功能按传输类分组：某类开关打开（见状态页）才显示对应模块行 -->
            <LinearLayout
                android:id="@+id/groupWifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/APSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lay_transport_wifi" />

                <LinearLayout
                    android:id="@+id/rowsWifi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/groupBt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/APSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lay_transport_bt" />

                <LinearLayout
                    android:id="@+id/rowsBt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/groupUsb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/APSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lay_transport_usb_group" />

                <LinearLayout
                    android:id="@+id/rowsUsb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_8"
                android:background="@color/card_stroke" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_12">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lay_settings_text_hotkey"
                        android:textAppearance="@style/APTextSubtitle" />


                </LinearLayout>

                <Switch
                    android:id="@+id/swHotkeySort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/lay_settings_cd_hotkey" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_8"
                android:background="@color/card_stroke" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_12">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lay_settings_text_orient_lock"
                        android:textAppearance="@style/APTextSubtitle" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swOrientLock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/lay_settings_cd_orient_lock" />
            </LinearLayout>
        </LinearLayout>


        </LinearLayout><!-- /groupGeneral -->

        <LinearLayout
            android:id="@+id/groupLook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- 主题方案 -->
        <TextView
            style="@style/APSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lay_settings_text_theme" />

        <LinearLayout
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/themeBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- 模块配色：触控板 / 键盘 / 快捷键 各自一套（默认跟随主题） -->
        <TextView
            style="@style/APSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lay_settings_text_color" />

        <LinearLayout
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lay_settings_text_hotkey_theme_touchpad_keyboard"
                android:visibility="gone"
                android:textAppearance="@style/APTextCaption" />

            <LinearLayout
                android:id="@+id/skinBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_8" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_8"
                android:background="@color/card_stroke" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_12">

                <Button
                    android:id="@+id/btnExportTheme"
                    style="@style/APButtonGhost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lay_settings_text_export" />

                <Button
                    android:id="@+id/btnImportTheme"
                    style="@style/APButtonGhost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_8"
                    android:text="@string/lay_settings_text_import" />

                <Button
                    android:id="@+id/btnShareTheme"
                    style="@style/APButtonGhost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_8"
                    android:text="@string/lay_settings_text_share" />
            </LinearLayout>
        </LinearLayout>

        <!-- 背景与手感：背景（纯色 / 相册图）、动效速度、震动强度、按键音 -->
        <TextView
            style="@style/APSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lay_settings_text_background" />

        <LinearLayout
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lay_settings_text_background_2"
                android:visibility="gone"
                android:textAppearance="@style/APTextCaption" />

            <LinearLayout
                android:id="@+id/fxBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_8" />
        </LinearLayout>

        </LinearLayout><!-- /groupLook -->

        <LinearLayout
            android:id="@+id/groupRemote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- TV / PC 控制：连接状态 + 文件传输 + 遥控键映射（长按底栏「触控板」也可进入连接菜单） -->
        <TextView
            style="@style/APSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lay_settings_remote" />

        <LinearLayout
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/tvBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- 诊断：环境摘要（原在「通用」tab，挪到遥控 tab 与通道自检/日志同屏） -->
        <TextView
            style="@style/APSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lay_settings_group_diag" />

        <LinearLayout
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lay_settings_diag_hint"
                android:visibility="gone"
                android:textAppearance="@style/APTextCaption" />

            <TextView
                android:id="@+id/tvDiag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/common_unknown"
                android:textAppearance="@style/APTextCaption" />
        </LinearLayout>

        <TextView
            style="@style/APSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_filepanel_text_file" />

        <LinearLayout
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/fileBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            style="@style/APSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lay_settings_text_remote" />

        <LinearLayout
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/keymapBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- 互传（LocalSend）：局域网跨生态收文件（issue#45 · MVP1），默认关 -->
        <LinearLayout
            android:id="@+id/rowLocalSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/space_12"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="@dimen/space_6">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="互传（LocalSend）
开关=接收文件；点行=发送文件到电脑/其他平台"
                android:textColor="@color/md_on_surface"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switchLocalSend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false" />
        </LinearLayout>

        </LinearLayout><!-- /groupRemote -->

        <LinearLayout
            android:id="@+id/groupAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- 关于与支持：版本行 + 检查更新 + 意见反馈。
             自包含控件：状态、点击、静默检查都在 AboutCard 里，设置页其余代码零改动。 -->
        <TextView
            style="@style/APSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lay_settings_tab_about" />

        <com.allperiph.ui.AboutCard
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- 维护：两个按钮各占整行（并排时窄屏上文字会顶到边） -->
        <TextView
            style="@style/APSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_maintenance" />

        <LinearLayout
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnBattery"
                style="@style/APButtonGhost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_battery_whitelist" />

            <Button
                android:id="@+id/btnRefresh"
                style="@style/APButtonGhost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/action_refresh" />
        </LinearLayout>
        <!-- 手动导出 log.txt（issue 实测建议）：logcat 自进程 → Download/AllPeriph/ -->
        <LinearLayout
            android:id="@+id/rowExportLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/space_12"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="@dimen/space_6">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="导出运行日志
