<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页（复用块）：快捷键模板（**可折叠**）· 功能开关（含自动排序）· 环境摘要 · 主题方案 · 关于（版本/更新/反馈）· 维护。
  竖屏底部留 96dp 给悬浮底栏；横屏（layout-land）由外层覆盖为 16dp。

  折叠的原因：模板列表有 10 套预置 + 1 行自建入口，展开 ≈ 800dp，正好把一屏占满，
  导致"功能开关 / 主题方案"永远在第二屏。现在默认只留「当前模板 + 更换/展开」一行。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="96dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp">

        <!-- 状态块（原状态页并入设置页顶，反馈#10）：总开关 / 传输开关 / 链路诊断 /
             运行摘要。根节点已由 ScrollView 改为 LinearLayout 平铺，滚动交给本页外层。 -->
        <include
            layout="@layout/page_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 分类列表首页（反馈#10 批 B，方案 B）：点行进二级页；二级页经返回行回首屏 -->
        <LinearLayout
            android:id="@+id/categoryHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/catGeneral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/ui_main_cat_general"
                android:textColor="#DD000000"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/catLook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/ui_main_cat_look"
                android:textColor="#DD000000"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/catRemote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/ui_main_cat_remote"
                android:textColor="#DD000000"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/catAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/ui_main_cat_about"
                android:textColor="#DD000000"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/catHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/ui_main_cat_help"
                android:textColor="#DD000000"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 二级页返回行（默认隐藏，进分类后显示，点击回首屏） -->
        <LinearLayout
            android:id="@+id/btnBackHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_main_cat_back"
                android:textColor="#DD000000"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupGeneral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- 快捷键模板：默认折叠，只显示当前这一套 -->
        <TextView
            style="@style/APSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lay_settings_text_hotkey_template" />

        <LinearLayout
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lay_settings_text_hotkey_template_touchpad"
                android:textAppearance="@style/APTextCaption" />

            <LinearLayout
                android:id="@+id/rowTemplateCurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <TextView
                    android:id="@+id/tvTemplateCurrent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="—"
                    android:textAppearance="@style/APTextSubtitle" />

                <TextView
                    android:id="@+id/btnToggleTemplates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="2dp"
                    android:paddingBottom="6dp"
                    android:text="@string/ui_main_template_expand"
                    android:textColor="@color/md_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/templatesBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 功能开关：模块启停 + 快捷键排序（同一张卡，风格统一也省一屏） -->
        <TextView
            style="@style/APSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lay_settings_modules" />

        <LinearLayout
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 功能按传输类分组：某类开关打开（见状态页）才显示对应模块行 -->
            <LinearLayout
                android:id="@+id/groupWifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/APSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lay_transport_wifi" />

                <LinearLayout
                    android:id="@+id/rowsWifi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/groupBt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/APSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lay_transport_bt" />

                <LinearLayout
                    android:id="@+id/rowsBt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/groupUsb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/APSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lay_transport_usb_group" />

                <LinearLayout
                    android:id="@+id/rowsUsb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="@color/card_stroke" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lay_settings_text_hotkey"
                        android:textAppearance="@style/APTextSubtitle" />


                </LinearLayout>

                <Switch
                    android:id="@+id/swHotkeySort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/lay_settings_cd_hotkey" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="@color/card_stroke" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lay_settings_text_orient_lock"
                        android:textAppearance="@style/APTextSubtitle" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swOrientLock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/lay_settings_cd_orient_lock" />
            </LinearLayout>
        </LinearLayout>


        </LinearLayout><!-- /groupGeneral -->

        <LinearLayout
            android:id="@+id/groupLook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- 主题方案 -->
        <TextView
            style="@style/APSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lay_settings_text_theme" />

        <LinearLayout
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/themeBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- 模块配色：触控板 / 键盘 / 快捷键 各自一套（默认跟随主题） -->
        <TextView
            style="@style/APSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lay_settings_text_color" />

        <LinearLayout
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lay_settings_text_hotkey_theme_touchpad_keyboard"
                android:textAppearance="@style/APTextCaption" />

            <LinearLayout
                android:id="@+id/skinBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="@color/card_stroke" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="12dp">

                <Button
                    android:id="@+id/btnExportTheme"
                    style="@style/APButtonGhost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lay_settings_text_export" />

                <Button
                    android:id="@+id/btnImportTheme"
                    style="@style/APButtonGhost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/lay_settings_text_import" />

                <Button
                    android:id="@+id/btnShareTheme"
                    style="@style/APButtonGhost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/lay_settings_text_share" />
            </LinearLayout>
        </LinearLayout>

        <!-- 背景与手感：背景（纯色 / 相册图）、动效速度、震动强度、按键音 -->
        <TextView
            style="@style/APSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lay_settings_text_background" />

        <LinearLayout
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lay_settings_text_background_2"
                android:textAppearance="@style/APTextCaption" />

            <LinearLayout
                android:id="@+id/fxBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp" />
        </LinearLayout>

        </LinearLayout><!-- /groupLook -->

        <LinearLayout
            android:id="@+id/groupRemote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- TV / PC 控制：连接状态 + 文件传输 + 遥控键映射（长按底栏「触控板」也可进入连接菜单） -->
        <TextView
            style="@style/APSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lay_settings_remote" />

        <LinearLayout
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/tvBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- 诊断：环境摘要（原在「通用」tab，挪到遥控 tab 与通道自检/日志同屏） -->
        <TextView
            style="@style/APSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lay_settings_group_diag" />

        <LinearLayout
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lay_settings_diag_hint"
                android:textAppearance="@style/APTextCaption" />

            <TextView
                android:id="@+id/tvDiag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/common_unknown"
                android:textAppearance="@style/APTextCaption" />
        </LinearLayout>

        <TextView
            style="@style/APSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_filepanel_text_file" />

        <LinearLayout
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/fileBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            style="@style/APSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lay_settings_text_remote" />

        <LinearLayout
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/keymapBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        </LinearLayout><!-- /groupRemote -->

        <LinearLayout
            android:id="@+id/groupAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- 关于与支持：版本行 + 检查更新 + 意见反馈。
             自包含控件：状态、点击、静默检查都在 AboutCard 里，设置页其余代码零改动。 -->
        <TextView
            style="@style/APSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lay_settings_tab_about" />

        <com.allperiph.ui.AboutCard
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- 维护：两个按钮各占整行（并排时窄屏上文字会顶到边） -->
        <TextView
            style="@style/APSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_maintenance" />

        <LinearLayout
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnBattery"
                style="@style/APButtonGhost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_battery_whitelist" />

            <Button
                android:id="@+id/btnRefresh"
                style="@style/APButtonGhost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/action_refresh" />
        </LinearLayout>
        </LinearLayout><!-- /groupAbout -->

        <!-- 帮助与说明（反馈#10 批 B）：文字性说明集中地，各分类只留一行式条目 -->
        <LinearLayout
            android:id="@+id/groupHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/APSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_help_title_project" />

            <LinearLayout
                style="@style/APCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_help_project"
                    android:textColor="#CC000000"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                style="@style/APSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_help_title_link" />

            <LinearLayout
                style="@style/APCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_help_link"
                    android:textColor="#CC000000"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                style="@style/APSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_help_title_gesture" />

            <LinearLayout
                style="@style/APCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_help_gesture"
                    android:textColor="#CC000000"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                style="@style/APSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_help_title_faq" />

            <LinearLayout
                style="@style/APCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_help_faq"
                    android:textColor="#CC000000"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
