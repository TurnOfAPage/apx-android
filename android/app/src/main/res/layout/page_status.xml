<?xml version="1.0" encoding="utf-8"?>
<!--
  状态块（已并入设置页顶，反馈#10）：根节点改 LinearLayout 平铺，滚动交给设置页外层
  ScrollView；左右/底部留白由设置页统一提供（本块不再自带 padding）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageStatus"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp">

        <!-- 大号启动开关：整卡都是状态显示，右侧开关放大到易点区域 -->
        <LinearLayout
            style="@style/APCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/APTextCaption" />

            <TextView
                android:id="@+id/tvOverall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="@string/common_off"
                android:textColor="@color/md_on_background"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOverallSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="@string/common_unknown"
                android:textAppearance="@style/APTextCaption" />

            <!-- 三个传输开关（取代单总开关）：打开即启用该类下全部功能 -->
            <LinearLayout
                android:id="@+id/rowsTransport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/lay_transport_wifi"
                        android:textAppearance="@style/APTextSubtitle" />

                    <Switch
                        android:id="@+id/swWifi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/lay_transport_wifi_cd" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/lay_transport_bt"
                        android:textAppearance="@style/APTextSubtitle" />

                    <Switch
                        android:id="@+id/swBt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/lay_transport_bt_cd" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="USB"
                        android:textAppearance="@style/APTextSubtitle" />

                    <Switch
                        android:id="@+id/swUsb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/lay_transport_usb_cd" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvIdleHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingBottom="8dp"
            android:text="@string/hint_idle"
            android:textAppearance="@style/APTextCaption" />

        <!-- 批C：功能说明九行已搬进帮助页 groupHelp；本容器保留为空壳——
             StatusFragment ensureViews 找不到会 return false、MainActivity lateinit 会 NPE，
             子 TextView 无 id 故代码不可达；透明空壳高为 0、零渲染。 -->
        <LinearLayout
            android:id="@+id/boxIdleFeatures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:orientation="vertical"
            android:padding="0dp" />

        <!-- 批C：三步上手三行已搬进帮助页 groupHelp -->

        <LinearLayout
            android:id="@+id/boxRunning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                style="@style/APCardFlat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lay_running_summary"
                    android:textAppearance="@style/APTextSubtitle" />

                <TextView
                    android:id="@+id/tvRunningSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:text="@string/common_unknown"
                    android:textAppearance="@style/APTextCaption" />
            </LinearLayout>

            <!-- 链路诊断 -->
            <LinearLayout
                style="@style/APCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_link"
                    android:textAppearance="@style/APTextSubtitle" />

                <LinearLayout
                    android:id="@+id/rowsLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="6dp" />

                <TextView
                    android:id="@+id/tvLinkRtt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="@string/label_link_rt"
                    android:textAppearance="@style/APTextCaption" />
            </LinearLayout>

            <!-- 跟手程度：说的是"正常该是什么样 + 不跟手怎么办"，
                 不摆内部指标（旧版写「延迟预算 · 触控上行 ≤2ms」，用户读不出任何可行动信息） -->
            <LinearLayout
                style="@style/APCardFlat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/feel_title"
                    android:textAppearance="@style/APTextSubtitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:text="@string/feel_body"
                    android:textAppearance="@style/APTextCaption" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
